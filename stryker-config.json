{
  "stryker-config": {
    "project": "EricksonLopez.SharedKernel.csproj",
    "test-projects": [
      "EricksonLopez.SharedKernel.UnitTests.csproj"
    ],
    "thresholds": {
      "high": 100,
      "low": 98,
      "break": 95
    },
    "reporters": [
      "html",
      "cleartext",
      "progress",
      "json"
    ],
    "mutate": [
      "**/*.cs",
      "!bin/**",
      "!obj/**",
      "!**/*.g.cs",
      "!**/*.AssemblyInfo.cs"
    ],
    "ignore-methods": [
      "ConfigureAwait",
      "Dispose",
      "ConfigureGeneratedCodeAnalysis",
      "EnableConcurrentExecution"
    ],
    "ignore-mutations": []
  }
}
