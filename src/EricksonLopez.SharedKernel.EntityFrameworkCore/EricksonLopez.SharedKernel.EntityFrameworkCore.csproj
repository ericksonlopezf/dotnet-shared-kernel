<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.SharedKernel.EntityFrameworkCore</AssemblyName>
    <RootNamespace>EricksonLopez.SharedKernel.EntityFrameworkCore</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.SharedKernel.EntityFrameworkCore</PackageId>
    <Description>Entity Framework Core integration for EricksonLopez.SharedKernel. Provides NativeAOT-ready StrongId value converters, DomainEventsInterceptor for automatic event draining on SaveChanges, and ModelBuilder conventions.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>$(CommonPackageTags);efcore;entity-framework-core;domain-events;interceptor;value-converter;strongly-typed-id;orm</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EricksonLopez.SharedKernel\EricksonLopez.SharedKernel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="EricksonLopez.SharedKernel.EntityFrameworkCore.Tests" />
  </ItemGroup>
</Project>
