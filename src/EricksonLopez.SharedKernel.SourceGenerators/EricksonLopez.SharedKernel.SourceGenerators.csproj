<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>EricksonLopez.SharedKernel.SourceGenerators</AssemblyName>
    <RootNamespace>EricksonLopez.SharedKernel.SourceGenerators</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <IsRoslynComponent>true</IsRoslynComponent>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.SharedKernel.SourceGenerators</PackageId>
    <Description>Roslyn Incremental Source Generators for EricksonLopez.SharedKernel. Generates Strongly Typed ID boilerplate and zero-reflection, Native AOT-safe Dapper bulk registrations.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>$(CommonPackageTags);source-generator;source-generators;roslyn;code-generation;strongly-typed-id;dapper</PackageTags>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <DevelopmentDependency>true</DevelopmentDependency>
    <PublishAot>false</PublishAot>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IncludeSymbols>false</IncludeSymbols>
    <NoWarn>$(NoWarn);NU5128</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <!-- Package the generator in the analyzers/dotnet/cs path of the NuGet package -->
    <None Include="$(OutputPath)\$(AssemblyName).dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
  </ItemGroup>
</Project>
