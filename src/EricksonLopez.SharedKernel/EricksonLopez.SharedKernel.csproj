<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.SharedKernel</AssemblyName>
    <RootNamespace>EricksonLopez.SharedKernel</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- NativeAOT and trimming compatibility: applies to all supported TFMs -->
    <IsTrimmable>true</IsTrimmable>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableSingleFileAnalyzer>true</EnableSingleFileAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- NuGet packaging -->
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.SharedKernel</PackageId>
    <Description>A minimal Shared Kernel for DDD-based .NET applications. Provides zero-dependency, AOT-compatible domain primitives: Entity&lt;TId&gt;, AggregateRoot&lt;TId&gt;, DomainEvent, ValueObject, and IStrongId. Designed for Clean Architecture and CQRS. NativeAOT and Trimming compatible on all supported TFMs.</Description>
    <!-- Include README in NuGet package -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>$(CommonPackageTags);entity;aggregate-root;domain-events;value-object;strongly-typed-id;domain-primitives</PackageTags>
  </PropertyGroup>
  <ItemGroup>
    <TrimmerRootDescriptor Include="ILLink.Descriptors.xml" />
    <EmbeddedResource Include="ILLink.Descriptors.xml" LogicalName="ILLink.Descriptors.xml" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="EricksonLopez.Events.Contracts" />
    <PackageReference Include="EricksonLopez.DomainPrimitives.Abstractions" />
  </ItemGroup>
</Project>
