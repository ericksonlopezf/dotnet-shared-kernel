<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
    <AssemblyName>EricksonLopez.SharedKernel.Dapper</AssemblyName>
    <RootNamespace>EricksonLopez.SharedKernel.Dapper</RootNamespace>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    
    <!-- NuGet Package Metadata -->
    <IsPackable>true</IsPackable>
    <PackageId>EricksonLopez.SharedKernel.Dapper</PackageId>
    <Description>Dapper TypeHandler adapters and registration extensions for EricksonLopez.SharedKernel strong identifiers.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>$(CommonPackageTags);dapper;type-handler;strongly-typed-id;sql;micro-orm;data-access</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Dapper" />
    <ProjectReference Include="..\EricksonLopez.SharedKernel\EricksonLopez.SharedKernel.csproj" />
  </ItemGroup>
</Project>