<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- 0 means use all available CPU cores -->
    <MaxCpuCount>0</MaxCpuCount>
    <ResultsDirectory>./TestResults</ResultsDirectory>
    <!-- 5 minutes timeout to prevent stalled builds in CI while allowing Native AOT integration runs -->
    <TestSessionTimeout>300000</TestSessionTimeout>
  </RunConfiguration>

  <Execution>
    <ParallelWorkers>0</ParallelWorkers>
  </Execution>

  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura,opencover</Format>
          <Exclude>[*.Tests]*,[*.UnitTests]*,[*.ArchitectureTests]*,[*.IntegrationTests]*,[*.TestingUtilities]*,[*.NativeAotTests]*</Exclude>
          <SingleHit>false</SingleHit>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
