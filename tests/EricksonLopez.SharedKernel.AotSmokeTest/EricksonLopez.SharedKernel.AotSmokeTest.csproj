<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <PackageReference Include="EricksonLopez.DomainPrimitives.Abstractions" />
    <ProjectReference Include="..\..\src\EricksonLopez.SharedKernel\EricksonLopez.SharedKernel.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>EricksonLopez.SharedKernel.AotSmokeTest</RootNamespace>
    <AssemblyName>EricksonLopez.SharedKernel.AotSmokeTest</AssemblyName>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
    <IsTestProject>false</IsTestProject>
    <SonarQubeExclude>true</SonarQubeExclude>
    <!--
      Architectural Role:
      Standalone Native AOT binary assertion harness.
      Directly compiled via ILC (Intermediate Language Compiler) to validate that all SharedKernel
      primitives execute in a native, zero-reflection, zero-JIT trimmed environment.
    -->
    <NoWarn>$(NoWarn);CS8602;CA1510</NoWarn>
  </PropertyGroup>

</Project>
